# Production environment for docker-compose.prod.yml

# ── Core ───────────────────────────────────────────────
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-strong-secret
FRONTEND_ORIGIN=https://your-domain.com
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com
DOWNLOAD_SECRET=replace-with-strong-secret
EXTRA_CORS_ORIGINS=
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=your-domain.com
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=120

# ── Payments (Stripe) ─────────────────────────────────
PAYMENT_PROVIDER=stripe
PLATFORM_FEE_PERCENT=10
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Email ─────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass
SMTP_FROM="OBJEKTA" <noreply@objekta.io>
CONTACT_RECEIVER=team@objekta.io

# ── AI Providers / Python Service ─────────────────────
AI_SERVICE_URL=http://ai:8100
AI_PROVIDER=
AI_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=

# ── AWS S3 (optional) ─────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=your_bucket
S3_PUBLIC_BASE=https://your-cloudfront-domain
