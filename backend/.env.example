# Backend
NODE_ENV=production
PORT=10000
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.example.com
DOWNLOAD_SECRET=replace-with-strong-secret
EXTRA_CORS_ORIGINS=
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=

# Optional: AWS S3 (if uploads use S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=your_bucket
S3_PUBLIC_BASE=https://your-cloudfront-domain

# Optional: Stripe
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_PERCENT=10

# Optional: Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass
SMTP_FROM="OBJEKTA" <noreply@objekta.io>
CONTACT_RECEIVER=team@objekta.io

# Optional: AI Providers / Python AI Service
AI_SERVICE_URL=http://127.0.0.1:8100
AI_PROVIDER=
AI_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=
