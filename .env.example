# Frontend (Vite)
# Set this to your deployed backend base URL (Render) when deploying to Vercel.
VITE_API_BASE=https://your-backend.onrender.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Static assets (models/videos). Point this to your CDN/S3 bucket if assets are not in Vercel.
VITE_ASSET_BASE=https://your-cdn-or-bucket-url

# ── Backend / Server ──────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/objekta
JWT_SECRET=change-me-to-a-random-secret
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=120

# ── Marketplace Payments ──────────────────────────────
# "mock" for dev without Stripe, "stripe" for real payments
PAYMENT_PROVIDER=stripe
PLATFORM_FEE_PERCENT=10
# Stripe keys (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend Stripe publishable key (Vite env)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
