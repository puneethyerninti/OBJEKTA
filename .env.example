# Frontend (Vite)
# Set this to your deployed backend base URL (Render) when deploying to Vercel.
VITE_API_BASE=https://your-backend.onrender.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Static assets (models/videos). Point this to your CDN/S3 bucket if assets are not in Vercel.
VITE_ASSET_BASE=https://your-cdn-or-bucket-url

# ── Backend / Server ──────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/objekta
JWT_SECRET=change-me-to-a-random-secret
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
DOWNLOAD_SECRET=change-me-to-a-random-secret
EXTRA_CORS_ORIGINS=
TRUST_PROXY=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=120

# ── Marketplace Payments ──────────────────────────────
# "mock" for dev without Stripe, "stripe" for real payments
PAYMENT_PROVIDER=stripe
PLATFORM_FEE_PERCENT=10
# Stripe keys (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend Stripe publishable key (Vite env)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Email (Contact + Auth) ────────────────────────────
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OBJEKTA" <noreply@objekta.io>
CONTACT_RECEIVER=team@objekta.io

# ── AI Providers ──────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8100
AI_PROVIDER=auto
AI_MODEL=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=qwen2.5:14b-instruct
AI_REQUIRE_LLM=true
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Frontend fallback policy
# false => fail fast when model is unavailable (no hardcoded chat replies)
VITE_AI_ALLOW_RULE_FALLBACK=false

# ── AWS S3 (optional) ─────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE=
