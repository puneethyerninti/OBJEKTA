/* src/styles/dashboard.css
   OBJEKTA — Premium Dashboard Redesign
   Modern glassmorphism, Figma-style design system
   Scoped to .dashboard-root
*/

/* ══════════════════════════════════════════════════════════
   ANIMATIONS
   ══════════════════════════════════════════════════════ */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
@keyframes pulseGlow {
  0%, 100% { opacity: 0.4; }
  50%      { opacity: 0.8; }
}
@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 6px rgba(39,210,122,0.4); }
  50%      { box-shadow: 0 0 14px rgba(39,210,122,0.8); }
}
@keyframes progressShine {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}
@keyframes gradientShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6px); }
}

/* ══════════════════════════════════════════════════════════
   SCROLLBAR HIDING
   ══════════════════════════════════════════════════════ */
@supports (scrollbar-width: none) {
  .dashboard-root, .dashboard-root * { scrollbar-width: none; }
}
.dashboard-root, .dashboard-root * { -ms-overflow-style: none; }
.dashboard-root::-webkit-scrollbar, .dashboard-root *::-webkit-scrollbar { display: none; }

/* ══════════════════════════════════════════════════════════
   ROOT
   ══════════════════════════════════════════════════════ */
.dashboard-root {
  min-height: 100vh;
  box-sizing: border-box;
  overflow: visible;
  background: #060810;
  color: #e6ecf5;
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  position: relative;
}
.dashboard-root::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 1200px 600px at 5% 5%, rgba(127,90,240,0.12), transparent 60%),
    radial-gradient(ellipse 800px 500px at 95% 90%, rgba(0,215,255,0.06), transparent 50%),
    radial-gradient(ellipse 600px 400px at 50% 20%, rgba(255,71,163,0.04), transparent 50%);
  z-index: 0;
}
.dashboard-root *, .dashboard-root *::before, .dashboard-root *::after { box-sizing: border-box; }

/* ══════════════════════════════════════════════════════════
   LAYOUT
   ══════════════════════════════════════════════════════ */
.dash-layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ══════════════════════════════════════════════════════════
   SIDEBAR
   ══════════════════════════════════════════════════════ */
.dash-sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  background: linear-gradient(180deg, rgba(12,14,24,0.95), rgba(8,10,18,0.98));
  border-right: 1px solid rgba(255,255,255,0.04);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  z-index: 10;
  overflow-y: auto;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 8px;
  margin-bottom: 28px;
}
.sidebar-logo {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: linear-gradient(135deg, #7f5af0, #00d7ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 16px;
  color: #fff;
  box-shadow: 0 4px 16px rgba(127,90,240,0.3);
}
.sidebar-brand-text {
  font-weight: 800;
  font-size: 18px;
  letter-spacing: -0.5px;
  background: linear-gradient(135deg, #e0e6ff, #c4b5fd);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Nav items */
.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 24px;
}
.sidebar-nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  border: none;
  background: transparent;
  color: #8b92a8;
  font-size: 13.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s ease;
  width: 100%;
  text-align: left;
}
.sidebar-nav-item:hover {
  background: rgba(255,255,255,0.04);
  color: #cdd4e6;
}
.sidebar-nav-item--active,
.sidebar-nav-item--active:hover {
  background: rgba(127,90,240,0.1);
  color: #c4b5fd;
}
.sidebar-nav-item--active::before {
  content: '';
  position: absolute;
  left: 0;
  width: 3px;
  height: 20px;
  border-radius: 0 4px 4px 0;
  background: #7f5af0;
}

.sidebar-divider {
  height: 1px;
  background: rgba(255,255,255,0.04);
  margin: 12px 8px;
}

/* Create button */
.sidebar-create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 16px;
  border-radius: 10px;
  border: none;
  background: linear-gradient(135deg, #7f5af0 0%, #6c47e0 100%);
  color: #fff;
  font-weight: 700;
  font-size: 13.5px;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-bottom: 20px;
  box-shadow: 0 4px 16px rgba(127,90,240,0.25);
}
.sidebar-create-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(127,90,240,0.35);
  background: linear-gradient(135deg, #8b6af5 0%, #7654e8 100%);
}

/* Storage */
.sidebar-storage {
  padding: 12px;
  border-radius: 10px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.04);
  margin-top: auto;
  margin-bottom: 16px;
}
.storage-header {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: #8b92a8;
  margin-bottom: 8px;
}
.storage-bar {
  height: 6px;
  border-radius: 9999px;
  background: rgba(255,255,255,0.06);
  overflow: hidden;
}
.storage-fill {
  height: 100%;
  border-radius: 9999px;
  background: linear-gradient(90deg, #7f5af0, #00d7ff);
  transition: width 0.5s cubic-bezier(0.4,0,0.2,1);
}

/* Profile */
.sidebar-profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 8px;
  border-radius: 10px;
  cursor: pointer;
  transition: background 0.15s;
}
.sidebar-profile:hover {
  background: rgba(255,255,255,0.03);
}
.sidebar-avatar {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(127,90,240,0.3), rgba(0,215,255,0.25));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 14px;
  color: #fff;
  flex-shrink: 0;
  border: 1px solid rgba(255,255,255,0.06);
}
.sidebar-user-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.sidebar-user-name {
  font-weight: 600;
  font-size: 13px;
  color: #cdd4e6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sidebar-user-email {
  font-size: 11px;
  color: #6b7280;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sidebar-logout-btn {
  padding: 6px;
  border-radius: 6px;
  border: none;
  background: transparent;
  color: #6b7280;
  cursor: pointer;
  transition: all 0.15s;
  flex-shrink: 0;
}
.sidebar-logout-btn:hover {
  background: rgba(255,60,80,0.08);
  color: #ff6b6b;
}

/* ══════════════════════════════════════════════════════════
   MAIN CONTENT
   ══════════════════════════════════════════════════════ */
.dash-main {
  padding: 28px 32px;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
  position: relative;
}

/* ══════════════════════════════════════════════════════════
   WELCOME BANNER
   ══════════════════════════════════════════════════════ */
.dash-welcome {
  position: relative;
  padding: 28px 32px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(127,90,240,0.08) 0%, rgba(0,215,255,0.05) 60%, rgba(255,71,163,0.04) 100%);
  border: 1px solid rgba(127,90,240,0.12);
  overflow: hidden;
  animation: fadeIn 0.4s ease;
}
.welcome-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  position: relative;
  z-index: 1;
}
.welcome-title {
  margin: 0;
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.6px;
  line-height: 1.2;
  color: #f0f4ff;
}
.welcome-name {
  background: linear-gradient(135deg, #c4b5fd, #00d7ff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.welcome-sub {
  color: #8b92a8;
  font-size: 14px;
  margin-top: 6px;
  line-height: 1.5;
}
.welcome-sub strong {
  color: #c4b5fd;
  font-weight: 700;
}
.welcome-glow {
  position: absolute;
  top: -40px;
  right: -40px;
  width: 250px;
  height: 250px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(127,90,240,0.15), transparent 70%);
  animation: pulseGlow 4s ease-in-out infinite;
  pointer-events: none;
}

/* Search box */
.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border-radius: 12px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  min-width: 280px;
  transition: all 0.2s ease;
}
.search-box:focus-within {
  border-color: rgba(127,90,240,0.4);
  background: rgba(255,255,255,0.06);
  box-shadow: 0 0 0 3px rgba(127,90,240,0.1);
}
.search-icon { color: #6b7280; flex-shrink: 0; }
.search-input {
  flex: 1;
  border: none;
  background: none;
  color: #e0e6ff;
  font-size: 14px;
  outline: none;
  min-width: 0;
}
.search-input::placeholder { color: #4b5563; }
.search-kbd {
  padding: 3px 8px;
  border-radius: 6px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
  color: #6b7280;
  font-size: 11px;
  font-family: var(--font-mono, monospace);
  flex-shrink: 0;
}

/* ══════════════════════════════════════════════════════════
   METRICS ROW
   ══════════════════════════════════════════════════════ */
.dash-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  animation: fadeInUp 0.5s ease 0.1s both;
}
.metric-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 20px;
  border-radius: 14px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}
.metric-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  opacity: 0;
  transition: opacity 0.3s;
  background: linear-gradient(135deg, rgba(127,90,240,0.04), rgba(0,215,255,0.03));
}
.metric-card:hover::before { opacity: 1; }
.metric-card:hover {
  border-color: rgba(127,90,240,0.15);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
}
.metric-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.metric-icon--purple { background: rgba(127,90,240,0.12); color: #c4b5fd; }
.metric-icon--teal   { background: rgba(0,215,255,0.1);   color: #67e8f9; }
.metric-icon--pink   { background: rgba(255,71,163,0.1);  color: #f9a8d4; }
.metric-icon--amber  { background: rgba(255,154,62,0.1);  color: #fbbf24; }
.metric-body { flex: 1; min-width: 0; }
.metric-value {
  font-weight: 800;
  font-size: 22px;
  letter-spacing: -0.5px;
  color: #f0f4ff;
  line-height: 1;
}
.metric-unit {
  font-size: 13px;
  font-weight: 500;
  color: #6b7280;
  margin-left: 2px;
}
.metric-label {
  font-size: 12px;
  color: #6b7280;
  margin-top: 4px;
}
.metric-trend {
  display: flex;
  align-items: center;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
}
.metric-trend--up {
  background: rgba(39,210,122,0.1);
  color: #4ade80;
}

/* ══════════════════════════════════════════════════════════
   QUICK ACTIONS
   ══════════════════════════════════════════════════════ */
.dash-quick-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  animation: fadeInUp 0.5s ease 0.2s both;
}
.qa-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: 10px;
  border: none;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.qa-btn--primary {
  background: linear-gradient(135deg, #7f5af0, #6c47e0);
  color: #fff;
  box-shadow: 0 4px 16px rgba(127,90,240,0.25);
}
.qa-btn--primary:hover {
  box-shadow: 0 8px 24px rgba(127,90,240,0.35);
  transform: translateY(-1px);
}
.qa-btn--accent {
  background: linear-gradient(135deg, rgba(0,215,255,0.12), rgba(127,90,240,0.08));
  color: #67e8f9;
  border: 1px solid rgba(0,215,255,0.2);
}
.qa-btn--accent:hover {
  background: linear-gradient(135deg, rgba(0,215,255,0.18), rgba(127,90,240,0.12));
  border-color: rgba(0,215,255,0.35);
  transform: translateY(-1px);
}
.qa-btn--glass {
  background: rgba(255,255,255,0.03);
  color: #8b92a8;
  border: 1px solid rgba(255,255,255,0.06);
}
.qa-btn--glass:hover {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.12);
  color: #cdd4e6;
  transform: translateY(-1px);
}

/* ══════════════════════════════════════════════════════════
   PROJECTS SECTION
   ══════════════════════════════════════════════════════ */
.dash-projects-section {
  animation: fadeInUp 0.5s ease 0.3s both;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 16px;
}
.section-header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-title {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
  color: #e0e6ff;
  display: flex;
  align-items: center;
  gap: 8px;
}
.section-icon { color: #c4b5fd; }
.section-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  height: 22px;
  padding: 0 8px;
  border-radius: 999px;
  background: rgba(127,90,240,0.12);
  color: #c4b5fd;
  font-size: 12px;
  font-weight: 700;
}
.section-header-right {
  display: flex;
  align-items: center;
  gap: 8px;
}
.sort-select {
  padding: 7px 12px;
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.06);
  background: rgba(255,255,255,0.03);
  color: #8b92a8;
  font-size: 12.5px;
  cursor: pointer;
  transition: border-color 0.15s;
}
.sort-select:hover { border-color: rgba(255,255,255,0.12); }
.sort-select:focus { border-color: rgba(127,90,240,0.35); outline: none; }

/* View toggle */
.view-toggle {
  display: flex;
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.06);
  overflow: hidden;
}
.view-btn {
  padding: 7px 10px;
  border: none;
  background: transparent;
  color: #4b5563;
  cursor: pointer;
  transition: all 0.15s;
  display: flex;
  align-items: center;
}
.view-btn:hover { color: #8b92a8; background: rgba(255,255,255,0.03); }
.view-btn--active {
  background: rgba(127,90,240,0.12);
  color: #c4b5fd;
}

/* ══════════════════════════════════════════════════════════
   PROJECT CARDS GRID
   ══════════════════════════════════════════════════════ */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
}
.projects-grid.list-view {
  grid-template-columns: 1fr;
  gap: 8px;
}

/* ── PROJECT CARD ─────────────────────────────────── */
.project-card {
  position: relative;
  border-radius: 14px;
  overflow: hidden;
  cursor: pointer;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  transition: all 0.25s cubic-bezier(0.2,0.9,0.2,1);
  display: flex;
  flex-direction: column;
  animation: fadeIn 0.35s ease both;
}
.project-card::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(135deg, rgba(127,90,240,0.2), rgba(0,215,255,0.15), transparent, transparent);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.project-card:hover::before { opacity: 1; }
.project-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.2), 0 0 0 1px rgba(127,90,240,0.15);
  border-color: rgba(127,90,240,0.2);
}

/* List view card */
.projects-grid.list-view .project-card {
  flex-direction: row;
  min-height: 0;
}
.projects-grid.list-view .card-thumb-wrap {
  width: 160px;
  height: 90px;
  flex-shrink: 0;
}
.projects-grid.list-view .card-body {
  flex: 1;
  flex-direction: row;
  align-items: center;
}

/* Card thumbnail */
.card-thumb-wrap {
  position: relative;
  height: 170px;
  background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0.1));
  overflow: hidden;
}
.card-thumb-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}
.project-card:hover .card-thumb-wrap img {
  transform: scale(1.06);
}
.card-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2a2f40;
  background: linear-gradient(135deg, rgba(127,90,240,0.04), rgba(0,215,255,0.03));
}
.card-thumb-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(6,8,16,0.6));
  pointer-events: none;
}

/* Progress & status */
.card-progress-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  padding: 5px 10px;
  border-radius: 999px;
  background: rgba(6,8,16,0.75);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.08);
  color: #fff;
  font-weight: 700;
  font-size: 11px;
  display: flex;
  align-items: center;
  gap: 6px;
  z-index: 2;
}
.card-progress-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #7f5af0;
  box-shadow: 0 0 6px rgba(127,90,240,0.4);
}

/* Save progress overlay */
.card-save-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(6,8,16,0.8);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  z-index: 3;
  gap: 8px;
}
.card-save-text { font-size: 12px; font-weight: 600; color: #c4b5fd; }
.card-save-bar {
  width: 60%;
  height: 4px;
  border-radius: 4px;
  background: rgba(255,255,255,0.08);
  overflow: hidden;
}
.card-save-bar > div {
  height: 100%;
  border-radius: 4px;
  background: linear-gradient(90deg, #7f5af0, #00d7ff);
  transition: width 0.3s ease;
}

/* Collab avatars on card */
.card-collab-stack {
  position: absolute;
  bottom: 10px;
  left: 10px;
  display: flex;
  gap: -4px;
  z-index: 2;
}
.card-collab-dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 11px;
  color: #fff;
  background: linear-gradient(135deg, #7f5af0, #00d7ff);
  border: 2px solid #0a0c14;
  margin-left: -6px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}
.card-collab-dot:first-child { margin-left: 0; }

/* Card body */
.card-body {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 0;
}
.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
}
.card-title {
  font-weight: 700;
  font-size: 14px;
  color: #e0e6ff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}
.card-more-btn {
  padding: 4px;
  border-radius: 6px;
  border: none;
  background: transparent;
  color: #4b5563;
  cursor: pointer;
  transition: all 0.15s;
  flex-shrink: 0;
  opacity: 0;
}
.project-card:hover .card-more-btn { opacity: 1; }
.card-more-btn:hover {
  background: rgba(255,255,255,0.06);
  color: #8b92a8;
}
.card-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.card-date {
  font-size: 12px;
  color: #4b5563;
}
.card-actions {
  display: flex;
  gap: 4px;
  opacity: 0;
  transition: opacity 0.2s;
}
.project-card:hover .card-actions { opacity: 1; }
@media (hover: none) {
  .card-actions { opacity: 1; }
  .card-more-btn { opacity: 1; }
}
.card-action-btn {
  padding: 5px 10px;
  border-radius: 6px;
  border: 1px solid rgba(255,255,255,0.06);
  background: rgba(255,255,255,0.03);
  color: #8b92a8;
  font-size: 11.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
}
.card-action-btn:hover {
  background: rgba(127,90,240,0.08);
  border-color: rgba(127,90,240,0.2);
  color: #c4b5fd;
}

/* Presence indicator */
.card-presence {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  color: #4ade80;
}
.card-presence-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #4ade80;
  animation: dotPulse 2s ease-in-out infinite;
}

/* Skeleton */
.project-card.skeleton-card {
  pointer-events: none;
}
.skeleton-thumb {
  height: 170px;
  background: linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.05), rgba(255,255,255,0.02));
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
.skeleton-body { padding: 14px 16px; }
.skeleton-line {
  height: 10px;
  background: linear-gradient(90deg, rgba(255,255,255,0.03), rgba(255,255,255,0.06), rgba(255,255,255,0.03));
  background-size: 200% 100%;
  border-radius: 6px;
  margin-bottom: 8px;
  animation: shimmer 1.5s ease-in-out infinite;
}
.skeleton-line.w-60 { width: 60%; }
.skeleton-line.w-40 { width: 40%; }
.skeleton-line.short { width: 50%; }

/* ══════════════════════════════════════════════════════════
   PANELS ROW (Activity + Team)
   ══════════════════════════════════════════════════════ */
.dash-panels-row {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 16px;
  animation: fadeInUp 0.5s ease 0.4s both;
}
.panel-card {
  border-radius: 14px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  padding: 20px;
  transition: border-color 0.2s;
}
.panel-card:hover { border-color: rgba(255,255,255,0.08); }
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
.panel-title {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: #e0e6ff;
  display: flex;
  align-items: center;
  gap: 8px;
}
.panel-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 12px;
  border-radius: 8px;
  border: 1px solid rgba(127,90,240,0.2);
  background: rgba(127,90,240,0.06);
  color: #c4b5fd;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}
.panel-action-btn:hover {
  background: rgba(127,90,240,0.12);
  border-color: rgba(127,90,240,0.35);
}
.panel-empty-state {
  padding: 24px;
  text-align: center;
  color: #4b5563;
  font-size: 13px;
}

/* Activity timeline */
.activity-timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 12px 0;
  border-left: 2px solid rgba(255,255,255,0.04);
  margin-left: 7px;
  padding-left: 20px;
  position: relative;
}
.timeline-dot {
  position: absolute;
  left: -5px;
  top: 16px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #7f5af0;
  box-shadow: 0 0 8px rgba(127,90,240,0.3);
}
.timeline-content { flex: 1; min-width: 0; }
.timeline-text { font-size: 13px; color: #cdd4e6; line-height: 1.4; }
.timeline-when { font-size: 11px; color: #4b5563; display: block; margin-top: 4px; }

/* Team list */
.team-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.team-member {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  transition: background 0.15s;
}
.team-member:hover { background: rgba(255,255,255,0.02); }
.team-avatar {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(127,90,240,0.25), rgba(0,215,255,0.2));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 15px;
  color: #fff;
  flex-shrink: 0;
  position: relative;
}
.online-dot {
  position: absolute;
  bottom: -1px;
  right: -1px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #4ade80;
  border: 2px solid #0a0c14;
  animation: dotPulse 2s ease-in-out infinite;
}
.team-info { flex: 1; min-width: 0; }
.team-name { font-weight: 600; font-size: 13.5px; color: #cdd4e6; }
.team-role { font-size: 11px; color: #4b5563; }
.team-action {
  padding: 6px;
  border-radius: 6px;
  border: 1px solid rgba(255,255,255,0.06);
  background: transparent;
  color: #4b5563;
  cursor: pointer;
  transition: all 0.15s;
}
.team-action:hover {
  background: rgba(127,90,240,0.08);
  border-color: rgba(127,90,240,0.2);
  color: #c4b5fd;
}

/* ══════════════════════════════════════════════════════════
   SCENES SECTION
   ══════════════════════════════════════════════════════ */
.dash-scenes-section { animation: fadeInUp 0.5s ease 0.5s both; }
.scenes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 12px;
}
.scene-card {
  border-radius: 12px;
  overflow: hidden;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  cursor: pointer;
  transition: all 0.2s ease;
  animation: fadeIn 0.3s ease both;
}
.scene-card:hover {
  transform: translateY(-3px);
  border-color: rgba(127,90,240,0.2);
  box-shadow: 0 12px 28px rgba(0,0,0,0.15);
}
.scene-thumb {
  height: 120px;
  position: relative;
  overflow: hidden;
  background: rgba(255,255,255,0.01);
}
.scene-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}
.scene-card:hover .scene-thumb img { transform: scale(1.05); }
.scene-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2a2f40;
}
.scene-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6,8,16,0.4);
  opacity: 0;
  transition: opacity 0.2s;
}
.scene-card:hover .scene-overlay { opacity: 1; }
.scene-play-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: rgba(127,90,240,0.8);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(127,90,240,0.3);
}
.scene-body { padding: 10px 12px; }
.scene-name {
  font-weight: 600;
  font-size: 13px;
  color: #cdd4e6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.scene-meta { font-size: 11px; color: #4b5563; margin-top: 2px; }
.scene-actions {
  display: flex;
  gap: 4px;
  padding: 0 12px 10px;
}
.scene-action-btn {
  padding: 4px 8px;
  border-radius: 6px;
  border: 1px solid rgba(255,255,255,0.06);
  background: transparent;
  color: #4b5563;
  cursor: pointer;
  transition: all 0.15s;
}
.scene-action-btn:hover {
  background: rgba(127,90,240,0.08);
  color: #c4b5fd;
}
.scenes-loading {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.scene-skeleton {
  border-radius: 12px;
  overflow: hidden;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.04);
}

/* Empty state */
.empty-state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 48px 24px;
  border-radius: 14px;
  background: rgba(255,255,255,0.015);
  border: 1px dashed rgba(255,255,255,0.08);
  text-align: center;
}
.empty-icon-wrap {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(127,90,240,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7280;
  animation: float 3s ease-in-out infinite;
}
.empty-title {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  color: #cdd4e6;
}
.empty-desc {
  margin: 0;
  font-size: 13px;
  color: #4b5563;
  max-width: 320px;
}

/* ══════════════════════════════════════════════════════════
   ACCOUNT SECTION
   ══════════════════════════════════════════════════════ */
.dash-account-section { animation: fadeInUp 0.5s ease 0.6s both; }
.account-card {
  border-radius: 14px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  padding: 20px 24px;
  max-width: 480px;
}
.account-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 16px;
}
.account-avatar-lg {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(127,90,240,0.3), rgba(0,215,255,0.25));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 20px;
  color: #fff;
  border: 1px solid rgba(255,255,255,0.08);
}
.account-info { flex: 1; min-width: 0; }
.account-name { font-weight: 700; font-size: 16px; color: #e0e6ff; }
.account-email { font-size: 13px; color: #6b7280; margin-top: 2px; }
.account-meta { display: flex; gap: 24px; }
.account-meta-item { display: flex; flex-direction: column; gap: 2px; }
.account-meta-label { font-size: 11px; color: #4b5563; text-transform: uppercase; letter-spacing: 0.5px; }
.account-meta-value { font-size: 14px; font-weight: 600; color: #cdd4e6; }

/* ══════════════════════════════════════════════════════════
   FOOTER
   ══════════════════════════════════════════════════════ */
.dash-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,0.04);
  margin-top: 8px;
}
.footer-brand {
  font-weight: 800;
  font-size: 14px;
  background: linear-gradient(135deg, #c4b5fd, #67e8f9);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.footer-copy { font-size: 12px; color: #4b5563; }

/* ══════════════════════════════════════════════════════════
   CONTEXT MENU
   ══════════════════════════════════════════════════════ */
.ctx-menu {
  min-width: 200px;
  padding: 6px;
  border-radius: 12px;
  background: rgba(14,16,26,0.95);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 16px 48px rgba(0,0,0,0.6);
  display: flex;
  flex-direction: column;
  gap: 2px;
  animation: fadeIn 0.12s ease;
}
.ctx-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border-radius: 8px;
  border: none;
  background: transparent;
  color: #cdd4e6;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.12s;
  width: 100%;
  text-align: left;
}
.ctx-item:hover { background: rgba(127,90,240,0.08); color: #e0e6ff; }
.ctx-item--danger { color: #f87171; }
.ctx-item--danger:hover { background: rgba(248,113,113,0.08); color: #fca5a5; }
.ctx-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 4px 8px; }

/* ══════════════════════════════════════════════════════════
   ERROR BANNER
   ══════════════════════════════════════════════════════ */
.error-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 14px 18px;
  border-radius: 12px;
  background: rgba(248,113,113,0.06);
  border: 1px solid rgba(248,113,113,0.2);
  margin-bottom: 16px;
  animation: fadeIn 0.2s ease;
}
.error-content {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fca5a5;
  font-size: 13px;
}
.error-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #f87171;
  flex-shrink: 0;
}
.error-retry {
  padding: 6px 14px;
  border-radius: 8px;
  border: 1px solid rgba(248,113,113,0.25);
  background: rgba(248,113,113,0.08);
  color: #fca5a5;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
  white-space: nowrap;
}
.error-retry:hover { background: rgba(248,113,113,0.15); }

/* ══════════════════════════════════════════════════════════
   MODALS
   ══════════════════════════════════════════════════════ */
.modal-project-header {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 16px;
}
.modal-project-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(127,90,240,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c4b5fd;
  flex-shrink: 0;
}
.modal-label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: #6b7280;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.modal-label--spaced { margin-top: 16px; }
.modal-input {
  width: 100%;
  padding: 10px 14px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.06);
  background: rgba(255,255,255,0.03);
  color: #e0e6ff;
  font-size: 14px;
  transition: all 0.15s;
}
.modal-input:focus {
  border-color: rgba(127,90,240,0.4);
  box-shadow: 0 0 0 3px rgba(127,90,240,0.1);
  outline: none;
}
.modal-progress {
  display: flex;
  align-items: center;
  gap: 10px;
}
.modal-progress-track {
  flex: 1;
  height: 8px;
  border-radius: 999px;
  background: rgba(255,255,255,0.06);
  overflow: hidden;
  position: relative;
}
.modal-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7f5af0, #00d7ff);
  border-radius: 999px;
  transition: width 0.4s ease;
  position: relative;
}
.modal-progress-fill::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  animation: progressShine 2s ease-in-out infinite;
}
.modal-progress-num {
  font-weight: 700;
  font-size: 14px;
  min-width: 44px;
  text-align: right;
  color: #cdd4e6;
}
.modal-actions {
  display: flex;
  gap: 8px;
  margin-top: 20px;
  flex-wrap: wrap;
}
.modal-btn {
  padding: 10px 18px;
  border-radius: 10px;
  border: none;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
}
.modal-btn--primary {
  background: linear-gradient(135deg, #7f5af0, #6c47e0);
  color: #fff;
  box-shadow: 0 4px 16px rgba(127,90,240,0.25);
}
.modal-btn--primary:hover {
  box-shadow: 0 8px 20px rgba(127,90,240,0.3);
  transform: translateY(-1px);
}
.modal-btn--ghost {
  background: rgba(255,255,255,0.04);
  color: #8b92a8;
  border: 1px solid rgba(255,255,255,0.06);
}
.modal-btn--ghost:hover { background: rgba(255,255,255,0.06); color: #cdd4e6; }
.modal-btn--danger {
  background: rgba(248,113,113,0.08);
  color: #f87171;
  border: 1px solid rgba(248,113,113,0.2);
}
.modal-btn--danger:hover {
  background: rgba(248,113,113,0.15);
  color: #fca5a5;
}

/* Preview */
.preview-layout { display: flex; gap: 20px; flex-wrap: wrap; }
.preview-media { flex: 1; min-width: 300px; }
.preview-box {
  border-radius: 12px;
  overflow: hidden;
  background: #060810;
  height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.preview-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: #4b5563;
}
.preview-info { width: 260px; min-width: 200px; }
.preview-info__title { font-weight: 700; font-size: 18px; color: #e0e6ff; }
.preview-info__meta { font-size: 13px; color: #6b7280; margin-top: 8px; }
.preview-info__actions { display: flex; flex-direction: column; gap: 8px; margin-top: 20px; }

/* ══════════════════════════════════════════════════════════
   TOASTS
   ══════════════════════════════════════════════════════ */
.toasts-root {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 120;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.toast {
  padding: 12px 16px;
  border-radius: 12px;
  min-width: 240px;
  color: #e0e6ff;
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 16px 48px rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  animation: slideUp 0.18s ease;
  background: rgba(14,16,26,0.92);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}
.toast-info    { border-left: 3px solid #67e8f9; }
.toast-success { border-left: 3px solid #4ade80; }
.toast-warn    { border-left: 3px solid #fbbf24; }
.toast-error   { border-left: 3px solid #f87171; }
.toast-close {
  background: transparent;
  border: none;
  color: #6b7280;
  cursor: pointer;
  padding: 4px;
  border-radius: 4px;
}
.toast-close:hover { background: rgba(255,255,255,0.06); }

/* ══════════════════════════════════════════════════════════
   FOCUS
   ══════════════════════════════════════════════════════ */
.dashboard-root :focus-visible {
  box-shadow: 0 0 0 2px rgba(127,90,240,0.5);
  outline: none;
  border-radius: 8px;
}

/* ══════════════════════════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════════════════════ */
@media (max-width: 1100px) {
  .dash-metrics { grid-template-columns: repeat(2, 1fr); }
  .dash-panels-row { grid-template-columns: 1fr; }
}
@media (max-width: 900px) {
  .dash-layout {
    grid-template-columns: 1fr;
  }
  .dash-sidebar {
    position: relative;
    height: auto;
    border-right: none;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px 16px;
    gap: 12px;
    align-items: center;
  }
  .sidebar-brand { margin-bottom: 0; }
  .sidebar-nav { flex-direction: row; gap: 4px; margin-bottom: 0; }
  .sidebar-storage, .sidebar-divider { display: none; }
  .dash-main { padding: 20px 16px; }
  .welcome-content { flex-direction: column; align-items: flex-start; }
  .search-box { min-width: 100%; }
}
@media (max-width: 640px) {
  .dash-metrics { grid-template-columns: 1fr 1fr; }
  .dash-quick-actions { flex-wrap: wrap; }
  .dash-quick-actions .qa-btn { flex: 1 1 calc(50% - 5px); justify-content: center; }
  .projects-grid { grid-template-columns: 1fr; }
  .scenes-grid { grid-template-columns: 1fr 1fr; }
  .welcome-title { font-size: 22px; }
  .section-header { flex-direction: column; align-items: flex-start; gap: 10px; }
  .scenes-loading { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .dash-main { padding: 16px 12px; }
  .dash-metrics { grid-template-columns: 1fr; }
  .scenes-grid { grid-template-columns: 1fr; }
  .metric-card { padding: 14px 16px; }
  .welcome-title { font-size: 20px; }
}
